OPENALEX_API_KEY=
OPENALEX_MAILTO=
MATILDA_DB=.runtime/matilda.db
MATILDA_CACHE_TTL=86400
MATILDA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Studio only; never prefix secrets with VITE_.
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Alternative: select AI_PROVIDER=gemini explicitly. No automatic fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
